<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import edu.msoe.envsim.utilities.apputils.FoodRadarChart?>

<fx:root type="javafx.scene.layout.VBox" spacing="8" stylesheets="@style.css" styleClass="panel"
         style="-fx-background-color: rgba(30, 30, 30, 0.9); -fx-background-radius: 8; -fx-border-color: #555; -fx-border-radius: 8;"
         prefWidth="310" maxWidth="310" visible="false" focusTraversable="false"
         xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Agent Inspector" styleClass="title-label"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Label fx:id="generationHeaderLabel" styleClass="telemetry-category-label" text="Gen 0"/>
        <Button fx:id="unitsButton" styleClass="sim-button" focusTraversable="false" onAction="#cycleUnits"
                style="-fx-font-size: 10px; -fx-padding: 2 8;"/>
    </HBox>

    <Separator style="-fx-stroke: #444;"/>

    <!-- Scrollable stats: lets the pane shrink to fit the window instead of forcing the layout taller -->
    <ScrollPane fitToWidth="true" styleClass="transparent-scroll-pane"
                vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
        <VBox spacing="8">

            <!-- Vitals Section -->
            <VBox style="-fx-background-color: rgba(40, 40, 40, 0.6); -fx-background-radius: 6; -fx-border-color: #444; -fx-border-radius: 6;">
                <HBox fx:id="vitalsHeader" alignment="CENTER_LEFT" style="-fx-padding: 8 10; -fx-cursor: hand;">
                    <Label fx:id="vitalsArrowLabel" text="▼" styleClass="telemetry-category-label" style="-fx-font-size: 9px;"/>
                    <HBox minWidth="6"/>
                    <Label text="STATE" styleClass="telemetry-category-label"/>
                </HBox>
                <VBox fx:id="vitalsContent" spacing="4" style="-fx-padding: 0 10 10 10;">
                    <GridPane hgap="10" vgap="3">
                        <Label text="Energy:" styleClass="caption-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="energyLabel" styleClass="mono-value-label" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Health / Size:" styleClass="caption-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="healthLabel" styleClass="mono-value-label" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Mass:" styleClass="caption-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="massLabel" styleClass="value-label" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Terrain:" styleClass="caption-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <Label fx:id="terrainLabel" styleClass="value-label" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <!--                        <Label text="Predation:" styleClass="caption-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>-->
                        <!--                        <Label fx:id="predationLabel" styleClass="value-label" GridPane.rowIndex="4" GridPane.columnIndex="1"/>-->

                        <Label text="Priority:" styleClass="caption-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <Label fx:id="actionLabel" styleClass="value-label" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                        <Label text="Age:" styleClass="caption-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <Label fx:id="ageLabel" styleClass="value-label" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>
            </VBox>

            <!-- Dynamics Section -->
            <VBox style="-fx-background-color: rgba(40, 40, 40, 0.6); -fx-background-radius: 6; -fx-border-color: #444; -fx-border-radius: 6;">
                <HBox fx:id="dynamicsHeader" alignment="CENTER_LEFT" style="-fx-padding: 8 10; -fx-cursor: hand;">
                    <Label fx:id="dynamicsArrowLabel" text="▼" styleClass="telemetry-category-label" style="-fx-font-size: 9px;"/>
                    <HBox minWidth="6"/>
                    <Label text="MOVEMENT" styleClass="telemetry-category-label"/>
                </HBox>
                <VBox fx:id="dynamicsContent" spacing="4" style="-fx-padding: 0 10 10 10;">
                    <GridPane hgap="10" vgap="3">
                        <Label text="Speed:" styleClass="caption-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="speedLabel" styleClass="value-label" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Acceleration:" styleClass="caption-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="accelerationLabel" styleClass="value-label" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Turn Rate:" styleClass="caption-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="turnRateLabel" styleClass="value-label" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Movement Effort:" styleClass="caption-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <Label fx:id="effortLabel" styleClass="value-label" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="Random Turn Requested:" styleClass="caption-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <Label fx:id="jitterLabel" styleClass="value-label" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>
            </VBox>

            <!-- Attributes Section -->
            <VBox style="-fx-background-color: rgba(40, 40, 40, 0.6); -fx-background-radius: 6; -fx-border-color: #444; -fx-border-radius: 6;">
                <HBox fx:id="attributesHeader" alignment="CENTER_LEFT" style="-fx-padding: 8 10; -fx-cursor: hand;">
                    <Label fx:id="attributesArrowLabel" text="▼" styleClass="telemetry-category-label" style="-fx-font-size: 9px;"/>
                    <HBox minWidth="6"/>
                    <Label text="ATTRIBUTES" styleClass="telemetry-category-label"/>
                </HBox>
                <VBox fx:id="attributesContent" spacing="4" style="-fx-padding: 0 10 10 10;">
                    <GridPane hgap="10" vgap="3">
                        <Label text="Max Accel:" styleClass="caption-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="maxSpeedLabel" styleClass="value-label" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Turn Speed:" styleClass="caption-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="turnSpeedLabel" styleClass="value-label" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Vision Radius:" styleClass="caption-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="visionLabel" styleClass="value-label" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="FOV:" styleClass="caption-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <Label fx:id="fovLabel" styleClass="value-label" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="Health Regen:" styleClass="caption-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <Label fx:id="regenLabel" styleClass="value-label" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Label text="Swim Skill:" styleClass="caption-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <Label fx:id="swimSkillLabel" styleClass="value-label" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                        <Label text="Attack:" styleClass="caption-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <Label fx:id="attackLabel" styleClass="value-label" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                        <Label text="Defense:" styleClass="caption-label" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                        <Label fx:id="defenseLabel" styleClass="value-label" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>
            </VBox>

            <!-- Food Preferences Section -->
            <VBox style="-fx-background-color: rgba(40, 40, 40, 0.6); -fx-background-radius: 6; -fx-border-color: #444; -fx-border-radius: 6;">
                <HBox fx:id="foodHeader" alignment="CENTER_LEFT" style="-fx-padding: 8 10; -fx-cursor: hand;">
                    <Label fx:id="foodArrowLabel" text="▼" styleClass="telemetry-category-label" style="-fx-font-size: 9px;"/>
                    <HBox minWidth="6"/>
                    <Label text="FOOD PREFERENCES" styleClass="telemetry-category-label"/>
                </HBox>
                <VBox fx:id="foodContent" alignment="CENTER" spacing="4" style="-fx-padding: 0 10 10 10;">
                    <FoodRadarChart fx:id="foodRadarChart" width="200" height="150"/>
                    <HBox spacing="15" alignment="CENTER">
                        <Label fx:id="food1Label" styleClass="value-label" style="-fx-font-size: 10px;"/>
                        <Label fx:id="food2Label" styleClass="value-label" style="-fx-font-size: 10px;"/>
                        <Label fx:id="food3Label" styleClass="value-label" style="-fx-font-size: 10px;"/>
                    </HBox>
                </VBox>
            </VBox>

        </VBox>
    </ScrollPane>

    <!-- Footer Actions -->
    <HBox spacing="8" style="-fx-padding: 4 0 0 0;">
        <Button text="Follow" styleClass="sim-button" focusTraversable="false" onAction="#goToAgent" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="Save" styleClass="sim-button" focusTraversable="false" onAction="#saveCurrentAgent" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="Close" styleClass="sim-button" focusTraversable="false" onAction="#hide" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>
</fx:root>
